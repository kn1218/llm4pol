.omc/
.claude/settings.local.json
.claude/hooks/node_modules/
node_modules/
__pycache__/
*.pyc
*.pkl
.DS_Store
Thumbs.db

# secrets (API keys) -- never commit
.env
.env.*
!.env.example

# editable-install build metadata (generated by `pip install -e`)
*.egg-info/

# pixi's own per-project install cache -- env/pixi.lock itself is NOT ignored;
# it is committed so the environment is reproducible on Windows and Linux.
.pixi/
env/.pixi/

# tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.import_linter_cache/

# PoLyInfo-derived data: the NIMS MatNavi terms forbid redistribution, so no
# data file is ever committed. data/MANIFEST.sha256 records what belongs here
# and data/README.md explains how to place the files locally.
data/raw/
data/interim/
data/processed/

# run outputs (ADR-0007): the ledger and everything else in a run directory stay
# untracked for size; the four summaries of each run are tracked so that a
# published number can be cited from the repository. A run that reads
# PoLyInfo-derived data stays untracked in full (ADR-0001); the governance test
# enforces it. The directory itself must be re-included, or the re-include of a
# file inside it does nothing. experiments/README.md documents the layout.
experiments/*
!experiments/README.md
!experiments/*/
experiments/*/*
!experiments/*/meta.json
!experiments/*/usage.json
!experiments/*/results.csv
!experiments/*/run_summary.json

# notebooks: checkpoints and rendered outputs
.ipynb_checkpoints/

# GSD per-session runtime sentinel (dispatch isolation); .planning/ itself is tracked
.gsd/
