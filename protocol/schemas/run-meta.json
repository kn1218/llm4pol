{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kn1218/llm4pol/protocol/schemas/run-meta.json",
  "title": "LLM4POL run meta -- charter section 7 run record, CONTEXT D-01, D-39",
  "description": "meta.json of a run, written once when the run opens: the problem, the code identity (git sha and whether the tree was dirty), the prompt versions, the provider and model, the seed, the snapshot and the sha256 of its source file, the registry version, the selector identity and whether a provider key was configured. All fifteen keys are required and every object is closed. A provider key is recorded as a boolean and never as a value (charter section 12). This schema is self-contained (no cross-file reference) because the schema-inventory step validates without a registry; $defs/problem is the body of problem-spec.json and tests/test_run_cli.py compares the two. A change that a reported result depends on is a new schema version in a new file (charter section 4 A-5), never an edit of this one once results cite it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "problem",
    "code_git_sha",
    "dirty",
    "prompt_versions",
    "provider",
    "model",
    "seed",
    "snapshot",
    "snapshot_sha256",
    "registry_version",
    "selector",
    "provider_key_configured"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "problem": {
      "$ref": "#/$defs/problem"
    },
    "code_git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirty": {
      "type": "boolean"
    },
    "prompt_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot": {
      "type": "string",
      "pattern": "^polyomics:general_polymers@[0-9a-f]{8}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "selector": {
      "type": "string",
      "minLength": 1
    },
    "provider_key_configured": {
      "type": "boolean"
    }
  },
  "$defs": {
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "objective",
        "constraints",
        "form",
        "budget",
        "table",
        "seed"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "property",
            "direction"
          ],
          "properties": {
            "property": {
              "enum": [
                "thermal_conductivity",
                "dielectric_const_dc",
                "tg",
                "rg",
                "r2",
                "ffv",
                "sp_ced",
                "density",
                "refractive_index"
              ]
            },
            "direction": {
              "enum": [
                "max",
                "min"
              ]
            }
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "property",
              "op",
              "value"
            ],
            "properties": {
              "property": {
                "enum": [
                  "thermal_conductivity",
                  "dielectric_const_dc",
                  "tg",
                  "rg",
                  "r2",
                  "ffv",
                  "sp_ced",
                  "density",
                  "refractive_index"
                ]
              },
              "op": {
                "enum": [
                  "<=",
                  ">="
                ]
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        "form": {
          "description": "`constrained_single` is the only form at M3. `pareto` is reserved for the D-16 gate (objective form, fixed at the Phase 7 pre-registration) and arrives as a new schema version, not as an edit of this enum.",
          "enum": [
            "constrained_single"
          ]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iterations",
            "candidates_per_beam",
            "beams"
          ],
          "properties": {
            "iterations": {
              "type": "integer",
              "minimum": 1
            },
            "candidates_per_beam": {
              "type": "integer",
              "minimum": 1
            },
            "beams": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "table": {
          "type": "string",
          "pattern": "^polyomics:general_polymers@[0-9a-f]{8}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
